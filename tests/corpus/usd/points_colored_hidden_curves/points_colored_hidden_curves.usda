#usda 1.0
(
    upAxis = "Y"
    metersPerUnit = 1.0
)

def Xform "Root"
{
    def Points "Cloud"
    {
        point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 2, 0)]
        color3f[] primvars:displayColor = [(1, 0, 0), (0, 1, 0), (0, 0, 1)] (
            interpolation = "vertex"
        )
    }
    def Points "Guide"
    {
        point3f[] points = [(9, 9, 9)]
        uniform token purpose = "guide"
    }
    def BasisCurves "Hidden"
    {
        int[] curveVertexCounts = [2]
        point3f[] points = [(0, 0, 0), (9, 0, 0)]
        uniform token type = "linear"
        token visibility = "invisible"
    }
}
